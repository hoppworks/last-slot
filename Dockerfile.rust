FROM rust:1.96-bookworm@sha256:a339861ae23e9abb272cea45dfafde21760d2ce6577a70f8a926153677902663 AS builder

ARG PACKAGE
WORKDIR /workspace

RUN apt-get update \
    && apt-get install --yes --no-install-recommends protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY proto ./proto
COPY migrations ./migrations
COPY crates ./crates

RUN cargo build --locked --release --package "${PACKAGE}" \
    && cp "target/release/${PACKAGE}" /tmp/service

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241

RUN useradd --create-home --uid 10001 lastslot
COPY --from=builder /tmp/service /usr/local/bin/service

USER lastslot
ENTRYPOINT ["/usr/local/bin/service"]
